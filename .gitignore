__pycache__/
*.pyc
.scratch/
# Scratch output from the usage-guide examples.
/out/
.venv/
.pytest_cache/
build/
dist/
ground_truth/captures/*
!ground_truth/captures/MANIFEST.md
*.egg-info/
.DS_Store

# EasyLanguage strategy source is proprietary -- never commit it.
# (Case-insensitive filesystems match .el too, so re-allow the public folders.)
*.EL
!examples/**
!ground_truth/**
!tests/fixtures/emitted/**
!pl_transpiler/_examples/**
# ...but captures stay private: re-ignore them after the folder-wide re-allow above.
ground_truth/captures/*
!ground_truth/captures/MANIFEST.md
# The drawing corpus's bars and MultiCharts readbacks are licensed too.
ground_truth/drawing/tapes/
ground_truth/drawing/*/mc/

# Built native accel extension (tools/build_accel.sh installs the cdylib here).
pl_transpiler/_accel*.so
pl_transpiler/_accel*.dylib
pl_transpiler/_accel*.pyd

.coverage
coverage.xml
